                    <OutArgument x:TypeArguments="x:String">[strEmailBody]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:String" xml:space="preserve">["Dear Sir / Madam&lt;br&gt;&lt;br&gt;" &amp;
"I write to confirm the results of your recent Interferon Gamma Test(s) from [" &amp; strDateCollected &amp; "]. The results are attached.&lt;br&gt;&lt;br&gt;" &amp;
"As this was an original resample test, no further testing of resamples will be required (this test is now complete).&lt;br&gt;&lt;br&gt;" &amp;
"Please contact your local APHA office at the below address if you have any queries and in particular to discuss any results that are not negative.&lt;br&gt;&lt;br&gt;" &amp;
"Further information about animals that have tested positive can be found at " &amp;
"&lt;a href='https://tbhub.co.uk/advice-during-a-tb-breakdown/actions-when-a-tb-reactor-is-found/'&gt;" &amp;
"https://tbhub.co.uk/advice-during-a-tb-breakdown/actions-when-a-tb-reactor-is-found/" &amp;
"&lt;/a&gt;, this information will be confirmed officially in writing by the APHA.&lt;br&gt;&lt;br&gt;" &amp;
"You are also encouraged to share and discuss this information with your Private Veterinary Surgeon.&lt;br&gt;&lt;br&gt;" &amp;
"To be able to read the attached document you will need software installed on your device that can read PDF files. There are a number of suitable free applications available including the original Adobe Acrobat PDF Reader. If you are using an Apple iPad and have problems printing the document then please ensure you have the latest version of IOS installed.&lt;br&gt;&lt;br&gt;" &amp;
"APHA is unable to provide any technical support regarding the use of any PDF software used to access the file.&lt;br&gt;&lt;br&gt;" &amp;
"Yours faithfully&lt;br&gt;" &amp;
"on behalf of the Veterinary Head of Field Delivery&lt;br&gt;&lt;br&gt;" &amp;
"For Support and advice during a TB breakdown: " &amp;
"&lt;a href='https://tbhub.co.uk/advice-during-a-tb-breakdown/support-organisations/'&gt;" &amp;
"https://tbhub.co.uk/advice-during-a-tb-breakdown/support-organisations/" &amp;
"&lt;/a&gt;&lt;br&gt;&lt;br&gt;" &amp;
"For Information about Gamma Testing: " &amp;
"&lt;a href='https://tbhub.co.uk/wp-content/uploads/2020/01/Factsheet_gamma_test_TB_hub.pdf'&gt;" &amp;
"https://tbhub.co.uk/wp-content/uploads/2020/01/Factsheet_gamma_test_TB_hub.pdf" &amp;
"&lt;/a&gt;&lt;br&gt;&lt;br&gt;" &amp;
"Website: &lt;a href='http://www.gov.uk/apha'&gt;www.gov.uk/apha&lt;/a&gt; | " &amp;
"Twitter: &lt;a href='http://www.twitter.com/aphagovuk'&gt;@APHAgovuk&lt;/a&gt; | " &amp;
"Facebook: &lt;a href='http://www.facebook.com/aphagov'&gt;aphagov&lt;/a&gt;&lt;br&gt;&lt;br&gt;" &amp;
"Address: APHA South West Regional Office, Isca Building, Manley House, Kestrel Way, Exeter, EX2 7LQ, Telephone: 03000200301&lt;br&gt;&lt;br&gt;" &amp;
"&lt;strong&gt;If you keep cattle, bison, buffalo, deer, goats, camelids, pigs, or sheep in England you are eligible to receive bespoke advice (by telephone or a free set of visits) from the TB Advisory Service on practical, cost-effective measures to increase your herd's resilience to bovine TB.&lt;/strong&gt;&lt;br&gt;&lt;br&gt;" &amp;
"&lt;strong&gt;You can apply by calling 01306 779410 or email info@tbas.org.uk, there is no charge for this service. Visit their website at &lt;/strong&gt;" &amp;
"&lt;a href='http://www.tbas.org.uk/'&gt;www.tbas.org.uk&lt;/a&gt;" &amp;
"&lt;strong&gt; to find out more.&lt;/strong&gt;"]</InArgument>
                  </Assign.Value>
                </Assign>
